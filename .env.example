# AdSync — Unified Social Ads Platform
# Copy this file to .env and fill in your values

# Flask secret key (change this to something random and secure)
SECRET_KEY=your-super-secret-key-here-change-me

# Optional: Pre-configure platform credentials (can also be done via UI)
# FACEBOOK_PAGE_ACCESS_TOKEN=your-page-access-token
# FACEBOOK_PAGE_ID=your-page-id
# INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token
# INSTAGRAM_ACCOUNT_ID=your-instagram-account-id
# TWITTER_API_KEY=your-api-key
# TWITTER_API_SECRET=your-api-secret
# TWITTER_ACCESS_TOKEN=your-access-token
# TWITTER_ACCESS_TOKEN_SECRET=your-access-token-secret
# LINKEDIN_ACCESS_TOKEN=your-access-token
# LINKEDIN_PERSON_URN=urn:li:person:your-id
