# Copy to .dev.vars (git-ignored) or run: npm run setup:secrets   (add -- --sandbox for the local mock platforms)
# Required
JWT_SECRET=replace-with-a-long-random-string
ENCRYPTION_KEY=replace-with-base64-32-bytes

# Optional: each feature switches on when its secrets are present (see docs/INTEGRATIONS.md)
# ANTHROPIC_API_KEY=
# META_APP_ID=
# META_APP_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# TIKTOK_APP_ID=
# TIKTOK_APP_SECRET=
